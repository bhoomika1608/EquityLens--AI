# ─────────────────────────────────────────────────────────────
# EquityLens AI — .gitignore
# ─────────────────────────────────────────────────────────────

# ── Secrets & Credentials (NEVER commit these) ─────────────
.env
.env.local
.env.production
*.pem
*.key
secrets/

# ── Runtime / Generated Data ────────────────────────────────
data/vector_store/
data/history/
*.pkl
*.faiss

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
.Python

# ── Virtual Environments ────────────────────────────────────
.venv/
venv/
env/
ENV/
.conda/

# ── HuggingFace / ML Model Cache ────────────────────────────
.cache/
models/
*.bin
*.safetensors

# ── Streamlit ────────────────────────────────────────────────
.streamlit/secrets.toml

# ── Testing ──────────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
coverage.xml
*.coveragerc

# ── IDEs ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/

# ── Legacy / Deprecated ──────────────────────────────────────
main.py
requirments.txt
faiss_store_openai.pkl
